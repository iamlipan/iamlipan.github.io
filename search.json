---
layout: null
sitemap: false
---
{% assign sep = "" %}[
{% for post in site.posts %}{{ sep }}{
  "title": {{ post.title | strip_html | jsonify }},
  "url": {{ post.url | prepend: site.baseurl | jsonify }},
  "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
  "cat": {{ post.categories | first | jsonify }},
  "tags": {{ post.tags | jsonify }},
  "body": {{ post.content | strip_html | strip_newlines | truncate: 3000, "" | jsonify }}
}{% assign sep = "," %}
{% endfor %}]
